NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Single admin account allowed into /admin (must match the email of a Supabase Auth user)
ADMIN_EMAIL=

# Stripe (test mode keys while developing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare Turnstile (public site key + secret key)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (sending-only scoped key, separate from the personal jdb@ SMTP relay)
RESEND_API_KEY=
